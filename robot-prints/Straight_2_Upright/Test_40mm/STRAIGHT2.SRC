&ACCESS RVP
DEF STRAIGHT2()
; EasyCAD: Straight 2 on the KUKA, nozzle upright
DECL EKI_STATUS RET
DECL SPL_VEL_MODE EC_MODE
DECL SPL_VEL_RESTR_STRUC EC_SAVED, EC_RESTR
BAS (#INITMOV,0)
$ACC.ORI1 = 150.0
$ACC.ORI2 = 150.0
$VEL.ORI1 = 200.0
$VEL.ORI2 = 200.0
$ADVANCE = 3
RET = EKI_SEND("EthernetKRL_Config", "STOP_EXTRUDE#")
$TOOL = TR_TOOL
; Reuse tool 6 inertia and inertia-axis orientation; override mass and COM XYZ.
$LOAD = LOAD_DATA[6]
$LOAD.M = TR_MASS
$LOAD.CM.X = TR_COM.X
$LOAD.CM.Y = TR_COM.Y
$LOAD.CM.Z = TR_COM.Z
$BASE = TR_BASE
$IPO_MODE = #BASE
$ORI_TYPE = #VAR
; SIMULATION ONLY - verify cell, cables and controller.
PTP $AXIS_ACT
RET = EKI_SEND("EthernetKRL_Config", "SET_TEMP T0 220#")
RET = EKI_SEND("EthernetKRL_Config", "SET_TEMP T1 190#")
RET = EKI_SEND("EthernetKRL_Config", "SET_TEMP T2 70#")
RET = EKI_SEND("EthernetKRL_Config", "SET_FAN1 0#")
RET = EKI_SEND("EthernetKRL_Config", "SET_FAN2 5#")
HALT
$VEL.CP = 0.05000
LIN {X 1088.30,Y 84.86,Z -589.70,A -90.00,B 0.00,C 0.00}
HALT
WAIT SEC 0
RET = EKI_SEND("EthernetKRL_Config", "CHANGE_SPEED1 12000#")
RET = EKI_SEND("EthernetKRL_Config", "START_EXTRUDE#")
WAIT SEC 20
RET = EKI_SEND("EthernetKRL_Config", "CHANGE_SPEED1 131#")
$VEL.CP = 0.10000
LIN {X 1151.09,Y -128.89,Z -653.70,A -90.00,B 0.00,C 0.00}
$VEL.CP = 0.02000
LIN {X 1151.09,Y -128.89,Z -658.70,A -90.00,B 0.00,C 0.00}
EC_MODE = $SPL_VEL_MODE
EC_SAVED = $SPL_VEL_RESTR
EC_RESTR = EC_SAVED
$SPL_VEL_MODE = #OPT
EC_RESTR.ORI_VEL = #ON
EC_RESTR.ORI_ACC = #ON
EC_RESTR.CART_ACC = #ON
$SPL_VEL_RESTR = EC_RESTR
SPLINE WITH $ACC={CP 0.050, ORI1 150.0, ORI2 150.0}
  SPL {X 1145.54,Y -120.64,Z -658.67,A -90.00,B 0.00,C 0.00} WITH $VEL.CP=0.02500
  SPL {X 1142.35,Y -116.82,Z -658.65,A -90.00,B 0.00,C 0.00} WITH $VEL.CP=0.02500
