&ACCESS RVP
DEF SPHR()
DECL EKI_STATUS RET
BAS (#INITMOV,0)
$ACC.ORI1 = 150.0
$ACC.ORI2 = 150.0
$VEL.ORI1 = 200.0
$VEL.ORI2 = 200.0
$ADVANCE = 3
RET = EKI_SEND("EthernetKRL_Config", "STOP_EXTRUDE#")
$TOOL = TR_TOOL
; Reuse tool 6 inertia and inertia-axis orientation; override mass and COM XYZ.
$LOAD = LOAD_DATA[6]
$LOAD.M = TR_MASS
$LOAD.CM.X = TR_COM.X
$LOAD.CM.Y = TR_COM.Y
$LOAD.CM.Z = TR_COM.Z
$BASE = TR_BASE
$IPO_MODE = #BASE
$ORI_TYPE = #VAR
; SIMULATION ONLY - verify cell, cables and controller.
PTP $AXIS_ACT
RET = EKI_SEND("EthernetKRL_Config", "SET_TEMP T0 220#")
RET = EKI_SEND("EthernetKRL_Config", "SET_TEMP T1 190#")
RET = EKI_SEND("EthernetKRL_Config", "SET_TEMP T2 70#")
RET = EKI_SEND("EthernetKRL_Config", "SET_FAN1 0#")
RET = EKI_SEND("EthernetKRL_Config", "SET_FAN2 5#")
HALT
$VEL.CP = 0.05
LIN {X 1088.30,Y 84.86,Z -589.70,A -90.00,B -0.00,C -0.00}
RET = EKI_SEND("EthernetKRL_Config", "CHANGE_SPEED1 12000#")
RET = EKI_SEND("EthernetKRL_Config", "START_EXTRUDE#")
WAIT SEC 20
RET = EKI_SEND("EthernetKRL_Config", "CHANGE_SPEED1 1000#")
$VEL.CP = 0.1
LIN {X 1078.34,Y -93.58,Z -652.70,A -90.00,B -0.00,C -0.00}
