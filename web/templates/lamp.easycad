easycad 0.1
project "Lamp"
printer "Ginger G1"
note "Shades that screw into each other: every vase-mode wall is a thread on both faces, one bead a turn at the socket's pitch. The first shade screws onto the socket; every shade with a straight start or end takes more shades, inside or outside, going up or down (docs/lamp-builder.md)."
note "Up is as the first shade prints: its start (on the socket) on the bed."
note "Threads (straight starts and ends, tubes) print at the pitch and the line; the shades in between can have their own layer height and line width, eased in and out along an S-curve through the fillets."

group "Socket"
param socket       = "E27" of ["E27", "E14", "custom"] "Socket (custom: a thread of your own)"
param fit          = 0 mm    in -2..2 step 0.1      "Socket fit (− is tighter)"
param thread_d     = 40 mm   in 5..300 step 0.1     "Custom thread diameter"  when socket = "custom"
param thread_pitch = 2.5 mm  in 0.5..5 step 0.1     "Custom thread pitch (the layer height)"  when socket = "custom"

group "Joints"
param joint_fit  = 0 mm    in -2..2 step 0.05       "Thread fit between shades (+ looser, − tighter)"
param joint      = 0 mm    in 0..200 step 1         "Every joint's length (0: each shade's own)"

group "Print"
param line       = 6 mm    in 1..12 step 0.1        "Line width"
param shade_layer = 0 mm   in 0..5 step 0.1         "Shade layer height (0: the pitch)"
param shade_line = 0 mm    in 0..12 step 0.1        "Shade line width (0: as the line)"
param flow       = 20      in 1..400                "Start flow (mm³/s)"
param shade_flow = 0       in 0..400                "Shade flow (mm³/s, 0: as the start)"
param flow_ramp  = 0 mm    in 0..200                "Flow ramp height (0: over the fillet)"
param tolerance  = 0.1 mm  in 0.01..1               "Chord tolerance"
param flat_top   = false                            "Flat closing turn (off: open spiral)"
param steady     = true                             "Steady flow in the first turn (faster where the bead is thin, up to the travel speed)"

group "Overhangs"
param slicing    = "height" of ["height", "surface"] "Slicing (surface: along the wall, experimental)"
param flat_flow  = 0       in 0..400                "Flow where it runs flat (mm³/s, 0: as the shade)"  when slicing = "surface"
param compensation = "layer height" of ["layer height", "width", "off"] "Compensation"
param strength   = 100 %   in 0..100                "Strength"  when slicing = "height"
param surface_strength = 0 % in 0..100              "Strength along the surface"  when slicing = "surface"
param steep      = 0       in 0..4 step 0.1         "Steep curve (0: even; more: less when shallow, more when steep)"  when not compensation = "off"
param pivot      = 45 deg  in 5..85 step 1          "Steep curve pivot (as now at this angle)"  when steep
param max_width  = 2.5     in 1..5 step 0.1         "Max line width (× the line)"  when compensation = "width"

group "Brim"
param brim       = false                            "Brim"
param brim_lines = 4       in 1..20 step 1          "Brim lines"  when brim
param brim_width = 6 mm    in 0.5..12 step 0.1      "Brim line width"  when brim
param brim_layer = 2.5 mm  in 0.1..5 step 0.05      "Brim layer height"  when brim
param brim_speed = 15      in 1..100                "Brim speed (mm/s)"  when brim
param brim_extrusion = 100 % in 10..300           "Brim extrusion"  when brim

# The thread: its pitch is every shade's layer height, so every turn lays one turn of thread.
row   = index_of(["E27", "E14", "custom"], socket)
pitch = item([2.5, 2, thread_pitch], row)
# The socket as a port (see the shade's ports): the first shade's start runs half a line
# outside the socket's thread; the socket fills its inside.
on_socket = [(item([40, 28, thread_d], row) + fit + line) / 2, 0, 1, 100000, less(row, 1.5), 1]

# ---- A shade. Where it's mounted comes in as a port: [the radius its straight start runs at,
# the height where that straight section ends, which way the section runs from there (+1 up),
# its length, whether it's the socket, which face (1 outside, -1 inside)].
component shade "Shade"
  group "Mount"
  input mount = on_socket "Mounted on"
  param direction  = "up" of ["up", "down"]          "Goes"  @ask
  param along      = 0 mm    in 0..1000 step 1       "How far along the section it sits"

  group "Shape"
  param shape      = "cone" of ["cone", "bell", "dome", "sphere", "flat sphere", "own", "bell in-out", "cone in-out", "tube"] "Shape"  @ask
  param start_len  = 20 mm   in 1..200 step 1        "Straight start (where it screws on)"
  param length     = 200 mm  in 10..1000 step 1      "Tube length"  when shape = "tube"
  param fillet     = 10 mm   in 0..100 step 1        "Fillet radius"  when not shape = ["tube", "bell in-out"]
  param opening    = 150 mm  in 10..400 step 1       "Opening diameter"  when shape = ["cone", "bell", "dome", "sphere", "flat sphere", "own"]
  param widest     = 200 mm  in 10..600 step 1       "Widest diameter"  when shape = ["bell in-out", "cone in-out"]
  param widest_at  = 50 %    in 5..95                "Widest at (of the height)"  when shape = ["bell in-out", "cone in-out"]
  param widest_len = 0 mm    in 0..1000 step 1       "Straight at the widest (0: none)"  when shape = ["bell in-out", "cone in-out"]
  param widest_fillet = 0 mm in 0..200 step 1  "Fillet at the widest"  when shape = "cone in-out"
  param end_d      = 0 mm    in 0..600 step 1        "End diameter (0: as the start)"  when shape = ["bell in-out", "cone in-out"]
  param transition = 52 mm   in 1..400 step 1        "Height"  when shape = ["cone", "bell", "dome", "sphere", "flat sphere", "own"]
  param inout_h    = 220 mm  in 10..1000 step 1      "Height"  when shape = ["bell in-out", "cone in-out"]
  param max_angle  = 0 deg   in 0..90 step 1         "Max angle (0: uncapped; 90: it opens out flat)"  when shape = "bell"
  param sphere     = 200 mm  in 20..500 step 1       "Sphere diameter (at its widest)"  when shape = ["sphere", "flat sphere"]
  param flatness   = 0.5     in 0.05..1 step 0.05    "Flatness (height ÷ width)"  when shape = "flat sphere"
  param own_at     = 50 %    in 5..95                "Middle point's height"  when shape = "own"
  param own_r      = 50 mm   in 5..250               "Middle point's radius"  when shape = "own"
  param closed     = false                           "Closed end (a flat disc, printed first)"  when not wings_on
  param closed_fillet = 10 mm in 0..100 step 1       "Closed end's fillet"  when closed
  param closed_layer = 0 mm  in 0..10 step 0.1       "Disc layer height (0: the shade's)"  when closed
  param end_straight = false                         "Straight end (more shades screw on there)"  when not closed
  param end_len    = 20 mm   in 1..200 step 1        "Straight end length"  when end_straight
  param lip_fillet = 0 mm    in 0..100 step 1        "End fillet (0: the start's)"  when end_straight
  param wide_down  = false                           "Printed wide edge down"  when not closed
  param wings_on   = false                            "Wings"

  group "Wings"
  param wing_mode  = "fades" of ["fades", "curve", "fit the shape"] "Wings follow"  when wings_on
  param wings      = 50 %    in 0..300               "Wings (100 %: the tips meet; past it, more walls; fitting the shape: at most)"  when wings_on and not wing_mode = "curve"
  param wing_curve = [[0, 100], [0.6, 80], [1, 20]] "Wings along the shade (0: where they can start, 1: where they end; %)"  when wings_on and wing_mode = "curve"
  param wing_side  = "inside" of ["inside", "outside"] "Wings on the"  when wings_on
  param wing_seams = 1       in 1..8 step 1          "Seams"  when wings_on
  param wing_gap   = 0 mm    in 0..10 step 0.1       "Gap between the walls"  when wings_on
  param wing_rise  = "whole layer" of ["whole layer", "tube wall", "wings"] "Rise along"  when wings_on
  param wing_in    = 60 mm   in 0..1000 step 1       "Fade in over"  when wings_on and not wing_mode = "curve"
  param wing_in_curve = "smooth" of ["linear", "smooth"] "Fade-in curve"  when wings_on and not wing_mode = "curve"
  param wing_out   = 0 mm    in 0..1000 step 1       "Fade out over (up to the straight end or the top; 0: none)"  when wings_on and not wing_mode = "curve"
  param wing_out_curve = "smooth" of ["linear", "smooth"] "Fade-out curve"  when wings_on and not wing_mode = "curve" and wing_out
  param wing_widen = "same diameter" of ["same diameter", "same layer length"] "Diameter as the wings fade out"  when wings_on and shape = "tube" and wing_mode = "fades" and wing_out

  # Where it's mounted, and its straight sections' lengths (the joint setting overrides both).
  m_r      = item(mount, 0)
  m_z      = item(mount, 1)
  m_in     = item(mount, 2)
  m_socket = item(mount, 4)
  start_eff = pick(joint, joint, start_len)
  end_on   = pick(end_straight, 1 - plain, 0) * (1 - is_closed)
  end_eff  = pick(joint, joint, end_len)
  r_t      = m_r
  throat   = start_eff
  r_b      = opening / 2
  inout    = greater(k_shape, 5.5) * less(k_shape, 7.5)
  h        = pick(inout, inout_h, transition)

  # Curved shades are sampled every 0.04 rad (2.3°) of wall angle, as EasyGCode samples them.
  flare_step = 0.04 * 180 / pi

  # ---- The shades. Each is radius `_r`, height `_z` and wall angle `_a` (degrees from vertical,
  # positive leaning out) along its curve, from the throat's radius at height 0 to the opening.
  cone_a = atan2(r_b - r_t, h)
  cone_r = [r_t, r_b]
  cone_z = [0, h]
  cone_l = [cone_a, cone_a]

  # Bell: leaves the throat straight up and bends outward; past `max_angle` it carries on straight.
  dr       = r_b - r_t
  natural  = 2 * atan2(dr, h)
  cap      = pick(max_angle, min(max_angle, 90 - 0.0001 * 180 / pi), natural)
  capped   = less(cap, natural - 0.000001 * 180 / pi)
  bell_on  = greater(dr, 0.000000001) * greater(cap, atan2(dr, h) + 0.000001 * 180 / pi)
  bell_end = pick(capped, cap, natural)
  bell_n   = max(12, ceil(bell_end / flare_step))
  bell_phi = bell_end * series(0, 1, bell_n + 1) / bell_n
  bell_big = pick(capped, (h * tan(cap) - dr) / max(0.000000001, 1 / cos(cap) - 1), h / max(0.000000001, sin(natural)))
  bell_r   = pick(bell_on, flatten([r_t + bell_big * (1 - cos(bell_phi)), pick(capped, [r_b], [])]), cone_r)
  bell_z   = pick(bell_on, flatten([bell_big * sin(bell_phi), pick(capped, [h], [])]), cone_z)
  bell_l   = pick(bell_on, flatten([bell_phi, pick(capped, [cap], [])]), cone_l)

  # Dome: leaves the throat steeply and curls back to vertical at the opening.
  dome_on  = greater(dr, 0.000000001)
  dome_top = 2 * atan2(dr, h)
  dome_big = h / max(0.000000001, sin(dome_top))
  dome_n   = max(12, ceil(dome_top / flare_step))
  dome_psi = -dome_top + dome_top * series(0, 1, dome_n + 1) / dome_n
  dome_r   = pick(dome_on, r_b - dome_big + dome_big * cos(dome_psi), cone_r)
  dome_z   = pick(dome_on, h + dome_big * sin(dome_psi), cone_z)
  dome_l   = pick(dome_on, -dome_psi, cone_l)

  # Sphere: the throat cuts one hole in it, the opening the other.
  big_r    = sphere / 2
  lat_1    = -acos(clamp(r_t / big_r, -1, 1))
  lat_2    = acos(clamp(r_b / big_r, -1, 1))
  sphere_n = max(16, ceil((lat_2 - lat_1) / flare_step))
  lat      = lat_1 + (lat_2 - lat_1) * series(0, 1, sphere_n + 1) / sphere_n
  sphere_r = big_r * cos(lat)
  sphere_z = big_r * sin(lat) - big_r * sin(lat_1)
  sphere_l = -lat

  # Flat sphere: an ellipsoid flattened to `flatness` of its width.
  flat_b   = big_r * clamp(flatness, 0.02, 1)
  flat_t   = lat_1 + (lat_2 - lat_1) * series(0, 1, 401) / 400
  flat_r   = big_r * cos(flat_t)
  flat_z   = flat_b * sin(flat_t) - flat_b * sin(lat_1)
  flat_l   = -atan(big_r / flat_b * tan(flat_t))

  # Your own shade: a smooth curve from the throat to the opening through points in between
  # (radius, 0, height). Its wall angle comes from its neighbours on each side.
  own_shade = catmull_rom([[r_t, 0, 0], [own_r, 0, h * own_at], [r_b, 0, h]])
  own_pts   = vertices(own_shade)
  own_rr    = sample(x, own_pts)
  own_zz    = sample(z, own_pts)
  own_i     = series(0, 1, count(own_pts))
  own_next  = min(own_i + 1, count(own_pts) - 1)
  own_prev  = max(own_i - 1, 0)
  own_l     = atan2(item(own_rr, own_next) - item(own_rr, own_prev), item(own_zz, own_next) - item(own_zz, own_prev))

  # Bell in-out: opens out to the widest diameter, then closes in to the end diameter, level
  # (straight up) where it starts, at its widest and where it ends: two S-curves.
  r_w      = widest / 2
  r_e      = pick(end_d, end_d / 2, r_t)
  w_at     = clamp(widest_at, 0.05, 0.95)
  # With a straight band at the widest (`widest_len`): out, straight down the band, then in;
  # the curves share the rest of the height, `widest_at` of it below the band.
  bio_band = clamp(widest_len, 0, 0.9 * h)
  bio_on   = greater(bio_band, 0.000000001)
  bio_hc   = h - bio_band
  bio_hu   = bio_hc * w_at
  bio_hd   = bio_hc * (1 - w_at)
  bio_u    = series(0, 1, 49) / 48
  bio_d    = pick(bio_on, series(0, 1, 49), series(1, 1, 48)) / 48
  bio_r    = flatten([r_t + (r_w - r_t) * smoothstep(bio_u), r_w + (r_e - r_w) * smoothstep(bio_d)])
  bio_z    = flatten([bio_hu * bio_u, bio_hu + bio_band + bio_hd * bio_d])
  bio_l    = flatten([atan((r_w - r_t) * 6 * bio_u * (1 - bio_u) / bio_hu), atan((r_e - r_w) * 6 * bio_d * (1 - bio_d) / bio_hd)])
  # Cone in-out: straight out to the widest diameter, straight down the band there (`widest_len`,
  # as the bell's), straight in to the end. Each corner at the widest (or the one corner, with no
  # band) is rounded by a tangent arc of radius `widest_fillet` (as big as fits: each line keeps
  # about half its length for the fillets at its ends). Along an arc the wall's lean runs from one
  # line's to the next; from its start S, at lean φ: S + R·s·(cos φ − cos a, sin a − sin φ), where a
  # is the lean coming in and s which way it turns (+1 to a smaller lean). With no fillet the arc
  # is the corner itself, there with each line's lean, so a fillet from the throat or to a straight
  # end meets each line's own lean.
  coi_hu   = bio_hu
  coi_hd   = bio_hd
  coi_a1   = atan2(r_w - r_t, coi_hu)
  coi_a2   = atan2(r_e - r_w, coi_hd)
  coi_l1   = sqrt((r_w - r_t) ^ 2 + coi_hu ^ 2)
  coi_l2   = sqrt((r_e - r_w) ^ 2 + coi_hd ^ 2)
  # The corner where the line out ends: into the band (lean 0), or with no band into the line in.
  cA_out   = pick(bio_on, 0, coi_a2)
  cA_th    = abs(coi_a1 - cA_out)
  cA_s     = pick(greater(coi_a1, cA_out), 1, -1)
  cA_room  = 0.45 * pick(bio_on, min(coi_l1, bio_band * 10 / 9), min(coi_l1, coi_l2))
  cA_rad   = max(0, min(widest_fillet, cA_room / max(0.000000001, tan(cA_th / 2))))
  cA_t     = cA_rad * tan(cA_th / 2)
  cA_n     = max(4, ceil(cA_th / flare_step))
  cA_phi   = coi_a1 + (cA_out - coi_a1) * series(0, 1, cA_n + 1) / cA_n
  cA_r     = r_w - cA_t * sin(coi_a1) + cA_rad * cA_s * (cos(cA_phi) - cos(coi_a1))
  cA_z     = coi_hu - cA_t * cos(coi_a1) + cA_rad * cA_s * (sin(coi_a1) - sin(cA_phi))
  # The corner where the band ends (with a band): from straight down (lean 0) into the line in.
  cB_th    = abs(coi_a2)
  cB_s     = pick(greater(0, coi_a2), 1, -1)
  cB_room  = 0.45 * min(bio_band * 10 / 9, coi_l2)
  cB_rad   = max(0, min(widest_fillet, cB_room / max(0.000000001, tan(cB_th / 2))))
  cB_t     = cB_rad * tan(cB_th / 2)
  cB_n     = max(4, ceil(cB_th / flare_step))
  cB_phi   = coi_a2 * series(0, 1, cB_n + 1) / cB_n
  cB_r     = r_w + cB_rad * cB_s * (cos(cB_phi) - 1)
  cB_z     = coi_hu + bio_band - cB_t - cB_rad * cB_s * sin(cB_phi)
  coi_r    = flatten([[r_t], cA_r, pick(bio_on, cB_r, []), [r_e]])
  coi_z    = flatten([[0], cA_z, pick(bio_on, cB_z, []), [h]])
  coi_l    = flatten([[coi_a1], cA_phi, pick(bio_on, cB_phi, []), [coi_a2]])

  # The chosen shade (a tube is the cone's arithmetic, replaced below by a straight wall).
  k_shape = index_of(["cone", "bell", "dome", "sphere", "flat sphere", "own", "bell in-out", "cone in-out", "tube"], shape)
  # A tube; a plain one (no wings) is all thread, start to end.
  is_tube = less(abs(k_shape - 8), 0.5)
  plain   = is_tube * (1 - pick(wings_on, 1, 0))
  fl_r = pick(less(k_shape, 0.5), cone_r, pick(less(k_shape, 1.5), bell_r, pick(less(k_shape, 2.5), dome_r, pick(less(k_shape, 3.5), sphere_r, pick(less(k_shape, 4.5), flat_r, pick(less(k_shape, 5.5), own_rr, pick(less(k_shape, 6.5), bio_r, pick(less(k_shape, 7.5), coi_r, cone_r))))))))
  # A bell or dome wider than it is tall can't be drawn as one arc (its wall would pass 90°): say how to fix it,
  # only for the shape that's chosen. The steps that read `fl_z` are skipped, so this is the only message.
  is_bell  = less(abs(k_shape - 1), 0.5)
  is_dome  = less(abs(k_shape - 2), 0.5)
  too_wide = greater(dr, h)
    fl_z = pick(less(k_shape, 0.5), cone_z, pick(less(k_shape, 1.5), bell_z, pick(less(k_shape, 2.5), dome_z, pick(less(k_shape, 3.5), sphere_z, pick(less(k_shape, 4.5), flat_z, pick(less(k_shape, 5.5), own_zz, pick(less(k_shape, 6.5), bio_z, pick(less(k_shape, 7.5), coi_z, cone_z)))))))) |> require(1 - is_bell * too_wide * less(max_angle, 0.000001), "This bell is wider than it is tall: raise the height, lower the opening, or set a max angle") |> require(1 - is_dome * too_wide, "This dome is wider than it is tall: raise the transition height or lower the opening")
  fl_l = pick(less(k_shape, 0.5), cone_l, pick(less(k_shape, 1.5), bell_l, pick(less(k_shape, 2.5), dome_l, pick(less(k_shape, 3.5), sphere_l, pick(less(k_shape, 4.5), flat_l, pick(less(k_shape, 5.5), own_l, pick(less(k_shape, 6.5), bio_l, pick(less(k_shape, 7.5), coi_l, cone_l))))))))

  # ---- The fillet: a tangent arc from the vertical throat onto the shade, where the shade first
  # reaches it (EasyGCode's blend). Too big to touch this shade: as big as it can be.
  fl_n    = count(fl_r)
  fl_rest = series(1, 1, fl_n - 1)
  f_r     = max(0, min(fillet, item(bounds((item(fl_r, fl_rest) - r_t) / max(0.000000000001, 1 - cos(item(fl_l, fl_rest)))), 1) * (1 - 0.000000000001)))
  g       = fl_r + f_r * cos(fl_l) - (r_t + f_r)
  blended = greater(f_r, 0.000000001) * less(item(g, 0), -0.000000001)
  hit     = index_of(flatten([[0], 1 - less(item(g, fl_rest), 0), [1]]), 1)
  g_a     = item(g, hit - 1)
  f       = clamp(g_a / min(-0.000000000001, g_a - item(g, hit)), 0, 1)
  p_r     = item(fl_r, hit - 1) + (item(fl_r, hit) - item(fl_r, hit - 1)) * f
  p_z     = item(fl_z, hit - 1) + (item(fl_z, hit) - item(fl_z, hit - 1)) * f
  p_l     = item(fl_l, hit - 1) + (item(fl_l, hit) - item(fl_l, hit - 1)) * f
  z_start = p_z - f_r * sin(p_l)
  arc_n   = max(4, ceil(abs(p_l) / flare_step))
  arc_phi = p_l * series(0, 1, arc_n + 1) / arc_n
  arc_r   = r_t + f_r * (1 - cos(arc_phi))
  arc_z   = z_start + f_r * sin(arc_phi)
  fl_tail = series(hit, 1, max(fl_n - hit, 1))
  cur_r   = pick(blended, flatten([[p_r], item(fl_r, fl_tail)]), fl_r)
  cur_z   = pick(blended, flatten([[p_z], item(fl_z, fl_tail)]), fl_z)
  cur_l   = pick(blended, flatten([[p_l], item(fl_l, fl_tail)]), fl_l)

  # ---- The straight end: the same blend, mirrored, turns the wall back to vertical at the
  # opening, and a straight end carries on from there. Read from the opening back, the wall
  # either comes from further out (a sphere closing in) or from further in (a cone or bell
  # opening out): the second is the first mirrored across the straight end (`sg` -1), so the
  # fillet rounds the corner either way.
  lip_on   = end_on
  cur_top  = item(cur_z, count(cur_z) - 1)
  r_open   = pick(greater(k_shape, 5.5), r_e, r_b)
  rv_r0    = reverse(cur_r)
  rv_l0    = -reverse(cur_l)
  sg       = pick(less(item(rv_r0, min(1, count(rv_r0) - 1)), r_open - 0.000001), -1, 1)
  rv_r     = r_open + sg * (rv_r0 - r_open)
  rv_z     = cur_top - reverse(cur_z)
  rv_l     = sg * rv_l0
  rv_n     = count(rv_r)
  rv_rest  = series(1, 1, rv_n - 1)
  lf       = max(0, min(pick(lip_fillet, lip_fillet, max(0, fillet)), item(bounds((item(rv_r, rv_rest) - r_open) / max(0.000000000001, 1 - cos(item(rv_l, rv_rest)))), 1) * (1 - 0.000000000001)))
  g2       = rv_r + lf * cos(rv_l) - (r_open + lf)
  lip_arc  = greater(lf, 0.000000001) * less(item(g2, 0), -0.000000001)
  hit2     = index_of(flatten([[0], 1 - less(item(g2, rv_rest), 0), [1]]), 1)
  g2_a     = item(g2, hit2 - 1)
  f2       = clamp(g2_a / min(-0.000000000001, g2_a - item(g2, hit2)), 0, 1)
  q_r      = item(rv_r, hit2 - 1) + (item(rv_r, hit2) - item(rv_r, hit2 - 1)) * f2
  q_z      = item(rv_z, hit2 - 1) + (item(rv_z, hit2) - item(rv_z, hit2 - 1)) * f2
  q_l      = item(rv_l, hit2 - 1) + (item(rv_l, hit2) - item(rv_l, hit2 - 1)) * f2
  z_start2 = q_z - lf * sin(q_l)
  arc2_n   = max(4, ceil(abs(q_l) / flare_step))
  arc2_phi = q_l * series(0, 1, arc2_n + 1) / arc2_n
  arc2_r   = r_open + sg * lf * (1 - cos(arc2_phi))
  arc2_z   = z_start2 + lf * sin(arc2_phi)
  rv_tail  = series(hit2, 1, max(rv_n - hit2, 1))
  # Back the right way up: what's left of the shade, the lip's arc down to vertical, the lip.
  arc2_down = series(arc2_n - 1, -1, arc2_n)
  lip_long  = greater(end_eff, 0.000000001)
  lipped_r  = pick(lip_arc, flatten([reverse(item(rv_r0, rv_tail)), [r_open + sg * (q_r - r_open)], item(arc2_r, arc2_down), pick(lip_long, [item(arc2_r, 0)], [])]), flatten([cur_r, pick(lip_long, [r_open], [])]))
  lipped_z  = pick(lip_arc, flatten([cur_top - reverse(item(rv_z, rv_tail)), [cur_top - q_z], cur_top - item(arc2_z, arc2_down), pick(lip_long, [cur_top - item(arc2_z, 0) + end_eff], [])]), flatten([cur_z, pick(lip_long, [cur_top + end_eff], [])]))
  lipped_l  = pick(lip_arc, flatten([-reverse(item(rv_l0, rv_tail)), [-sg * q_l], -sg * item(arc2_phi, arc2_down), pick(lip_long, [0], [])]), flatten([cur_l, pick(lip_long, [0], [])]))
  end_r     = pick(lip_on, lipped_r, cur_r)
  end_z     = pick(lip_on, lipped_z, cur_z)
  end_l     = pick(lip_on, lipped_l, cur_l)

  # ---- The whole profile: the throat, the fillet, then the shade (and lip).
  throat_on = greater(throat, 0.000000001)
  shift     = pick(blended, throat - z_start, throat)
  end_i     = series(blended, 1, count(end_r) - blended)
  prof_r    = flatten([pick(throat_on, [r_t, r_t], [r_t]), pick(blended, arc_r, []), item(end_r, end_i)])
  prof_z    = flatten([pick(throat_on, [0, throat], [0]), pick(blended, arc_z + shift, []), item(end_z, end_i) + shift])
  prof_l    = flatten([pick(throat_on, [0, 0], [0]), pick(blended, arc_phi, []), item(end_l, end_i)])
  fillet_top = pick(blended, item(arc_z, arc_n) + shift, throat)

  # A tube: one straight wall, its whole length.
  full_r  = pick(is_tube, [r_t, r_t], prof_r)
  full_z  = pick(is_tube, [0, pick(wing_on, max(pitch, z_w), length)], prof_z)
  full_l  = pick(is_tube, [0, 0], prof_l)

  # Printed start down, or wide edge down (the profile turned over; a tube with wings prints start
  # down, always). Its top: the profile's, or with wings, the wings' last layer's.
  wide_eff = pick(wide_down, 1, 0) * (1 - winged)
  top_z   = pick(wing_on, z_p0 + item(w_zb, w_lc), item(full_z, count(full_z) - 1))
  # Closed, it prints from the disc's edge (below), up the fillet and the shade to the thread.
  print_r = pick(is_closed, cap_r, pick(wide_eff, reverse(full_r), full_r))
  print_z = pick(is_closed, cap_z, pick(wide_eff, top_z - reverse(full_z), full_z))
  print_l = pick(is_closed, cap_l, pick(wide_eff, -reverse(full_l), full_l))
  profile = polyline(point(pick(w_shape * wing_on, [r_t, r_t], print_r), 0, pick(w_shape * wing_on, [0, max(pitch, z_w)], print_z)))

  # ---- Slicing: by height (each turn rises a pitch), or along the surface (each turn steps along
  # the wall; the turn's fields read z as the distance along the profile).
  surface  = less(abs(index_of(["height", "surface"], slicing) - 1), 0.5)
  seg_n    = count(print_r) - 1
  seg_len  = sqrt((item(print_r, series(1, 1, seg_n)) - item(print_r, series(0, 1, seg_n))) ^ 2 + (item(print_z, series(1, 1, seg_n)) - item(print_z, series(0, 1, seg_n))) ^ 2)
  print_s  = flatten([[0], accumulate(seg_len)])
  z_here   = pick(surface, graph(print_s, print_z, z), z)

  # ---- Turn by turn: wider beads, or a shorter rise squeezing the bead, where the wall leans;
  # the flow ramps from the throat's to the shade's over the fillet.
  # The extra (1/cos − 1 wider, or 1 − cos lower) is scaled by (angle / pivot)^steep: 1 everywhere
  # at 0; above 0, less below the pivot and more above it (pivot 45°, steep 2: 15° gets 1/9, 80°
  # about 3×).
  # Along the surface every bead is already a layer along the wall however it leans (the nozzle
  # turned with the wall makes up for the lean), so its own strength starts at 0.
  comp    = index_of(["width", "layer height", "off"], compensation)
  # Its threads print at the pitch and the line, the shade between them at its own: through the
  # start's fillet an S-curve of height from one to the other, and with a straight end back again
  # through the end's fillet (no fillet: at once, where the straight section starts or ends).
  # A tube is all thread.
  from_throat = pick(is_closed, top_z + cap_dl - z_here, pick(wide_eff, top_z - z_here, z_here))
  fil_h    = fillet_top - throat
  into_sh  = pick(greater(fil_h, 0.000000001), smoothstep(clamp((from_throat - throat) / max(fil_h, 0.000000001), 0, 1)), 1 - less(from_throat, throat))
  end_lo   = pick(lip_arc, cur_top - q_z, cur_top) + shift
  end_hi   = pick(lip_arc, cur_top - z_start2, cur_top) + shift
  out_sh   = pick(greater(end_hi - end_lo, 0.000000001), smoothstep(clamp((from_throat - end_lo) / max(end_hi - end_lo, 0.000000001), 0, 1)), 1 - less(from_throat, end_hi))
  to_shade = (1 - is_tube) * into_sh * (1 - lip_on * out_sh)
  sh_layer = pick(shade_layer, shade_layer, pitch)
  sh_line  = pick(shade_line, shade_line, line)
  layer_at = pitch + to_shade * (sh_layer - pitch)
  line_at  = line + to_shade * (sh_line - line)
  lean_at = pick(surface, graph(print_s, print_l, z), graph(print_z, print_l, z))
  c       = max(0.05, cos(abs(lean_at)))
  curve   = pick(surface, surface_strength, strength) * (min(abs(lean_at), 89) / pivot) ^ steep
  width   = pick(less(comp, 0.5), min(20, line_at * min(max_width, 1 + curve * (1 / c - 1))), line_at)
  squeeze = pick(less(abs(comp - 1), 0.5), max(0.05, 1 - curve * (1 - c)), 1)
  # By height each turn rises a layer (squeezed as above); along the surface it steps a layer along
  # the wall, so each bead lies on the one before it, a layer further on, wherever the wall goes.
  # Squeezed, each bead keeps its own layer's full cross-section.
  rise    = layer_at * squeeze
  ramp_h  = pick(flow_ramp, flow_ramp, fillet_top - throat)
  ramp    = pick(greater(ramp_h, 0.000000001), clamp((from_throat - throat) / max(ramp_h, 0.000000001), 0, 1), 1 - less(from_throat, throat))
  flow_sh = flow + ramp * (pick(shade_flow, shade_flow, flow) - flow)
  # Along the surface, optionally slower where it runs flat (beads hanging in the air need time
  # to cool): blending in from 60° to 90°.
  flat_at = smoothstep(clamp((abs(lean_at) - 60) / 30, 0, 1))
  flow_at = pick(surface * greater(flat_flow, 0), flow_sh + flat_at * (flat_flow - flow_sh), flow_sh)

  shade = vase_revolve(profile, layer: rise, width: width, flow: flow_at, bead_layer: pick(surface, layer_at, pick(less(abs(comp - 1), 0.5), layer_at, 0)), tolerance: tolerance, flat_top: pick(wing_on, false, flat_top), steady_start: steady, surface: surface)

  # A brim around the first turn, outermost ring first, hopping between rings and into the shade.
  first_rise  = sample(rise, [0, 0, min(top_z, sample(rise, [0, 0, 0]) / 2)])
  r_first     = graph(print_z, print_r, min(top_z, first_rise))
  brim_rings  = circle(pick(w_bedp, item(w_R, 0) + less(w_sig, 0) * 2 * w_J * w_s, r_first) + brim_width / 2 + sample(line_at, [0, 0, first_rise / 2]) / 2 + series(brim_lines - 1, -1, brim_lines) * brim_width, tolerance: tolerance) |> rotate(90)
  # The brim's own extrusion (100 %: as the bead's), for a first layer that needs more or less.
  brim_raw    = toolpath(graft(brim_rings), width: brim_width, layer: brim_layer, speed: brim_speed)
  brim_path   = pick(greater(abs(brim_extrusion - 1), 0.000001), adjust(brim_raw, extrude: brim_extrusion), brim_raw)
  brimmed     = join(flatten([aid(brim_path), [shade]]), clear: 2 * brim_layer)
  open_path   = pick(brim, brimmed, shade)

  # ---- A closed end: a flat disc where the shade ends, rising through a fillet into the wall;
  # printed disc down (upside down from the start), the start's thread last. The profile from
  # its end (as printed wide edge down), the fillet a tangent arc from the floor (lean 90°) to the
  # wall's lean where they meet, the disc the floor inside it. The disc is a spiral; then the
  # shade, as any shade prints (overhang compensation and all), its profile from the disc's edge
  # up the fillet (flat at first, so compensated the most) to the start's thread, its first turn
  # starting on the disc as any first turn starts on the bed.
  is_closed = pick(closed, 1, 0) * (1 - winged)
  # The disc is the shade's end: its layer (0) and line are the shade's (a tube's: the thread's).
  cap_dl   = pick(closed_layer, closed_layer, pick(is_tube, pitch, sh_layer))
  cap_w    = pick(is_tube, line, sh_line)
  cap_pr   = reverse(full_r)
  cap_pz   = top_z - reverse(full_z)
  # The wall's lean where the fillet meets it: the end's lean moves the meeting point, and that
  # point's lean the next; twice round settles it (a curved wall's fillet meets it tangent).
  cap_lr   = -reverse(full_l)
  cap_a0   = clamp(item(cap_lr, 0), -80, 80)
  cap_z0   = max(0, min(closed_fillet, (item(reverse(full_r), 0) - 1.5 * cap_w) / max(0.2, cos(cap_a0) + abs(tan(cap_a0)) * (1 - sin(cap_a0))))) * (1 - sin(cap_a0))
  cap_a1   = clamp(graph(top_z - reverse(full_z), cap_lr, min(cap_z0, top_z)), -80, 80)
  cap_z1   = max(0, min(closed_fillet, (item(reverse(full_r), 0) - 1.5 * cap_w) / max(0.2, cos(cap_a1) + abs(tan(cap_a1)) * (1 - sin(cap_a1))))) * (1 - sin(cap_a1))
  cap_a    = clamp(graph(top_z - reverse(full_z), cap_lr, min(cap_z1, top_z)), -80, 80)
  cap_re   = item(cap_pr, 0)
  cap_f    = max(0, min(closed_fillet, (cap_re - 1.5 * cap_w) / max(0.2, cos(cap_a) + abs(tan(cap_a)) * (1 - sin(cap_a)))))
  cap_zj   = cap_f * (1 - sin(cap_a))
  cap_rj   = graph(cap_pz, cap_pr, min(cap_zj, top_z))
  cap_cr   = max(cap_w, cap_rj - cap_f * cos(cap_a))
  cap_th   = -90 + (90 - cap_a) * series(0, 1, 13) / 12
  cap_ar   = cap_cr + cap_f * cos(cap_th)
  cap_az   = cap_f + cap_f * sin(cap_th)
  cap_hit  = index_of(flatten([greater(cap_pz, cap_zj + 0.000001), [1]]), 1)
  cap_tail = series(min(cap_hit, count(cap_pr) - 1), 1, max(1, count(cap_pr) - cap_hit))
  cap_r    = flatten([cap_ar, item(cap_pr, cap_tail)])
  cap_z    = flatten([cap_az, item(cap_pz, cap_tail)]) + cap_dl
  # Its wall's lean: the fillet's from flat (90°) to the wall's, then the shade's, turned over.
  cap_l    = flatten([-cap_th, item(-reverse(full_l), cap_tail)])
  # The disc: a spiral from the middle out, a line apart, ending exactly where the wall's first
  # turn starts (its radius a first rise up the fillet, as vase_revolve works it out, at the
  # seam, 90°), turned to end there, so the nozzle runs on from the disc into the wall with no
  # step.
  cap_q0   = pick(surface, 0, cap_dl)
  cap_dz   = sample(rise, [0, 0, cap_q0 + sample(rise, [0, 0, cap_q0]) / 2])
  cap_r0   = max(cap_w, pick(surface, graph(print_s, print_r, cap_dz), graph(print_z, print_r, cap_q0 + cap_dz)))
  cap_t    = cap_r0 / cap_w
  cap_disc = spiral(spacing: cap_w, turns: cap_t, tolerance: tolerance) |> rotate(90 - 360 * cap_t)
  cap_path = join([toolpath(cap_disc, width: cap_w, layer: cap_dl, flow: flow), shade], link: true)
  # A tube with wings: its straight start, then the wings; or printed wide edge down, end first
  # from the bed (any brim round it), its straight start last.
  wings_bed = pick(brim, join(flatten([aid(brim_path), [wing_path]]), clear: 2 * brim_layer), wing_path)
  path     = pick(is_closed, cap_path, pick(wing_on, pick(w_bedp, wings_bed, join([open_path, wing_path])), open_path))

  # ---- Tube with wings (docs/tube-with-wings.md): above its straight start, each layer
  # turns back on itself at its seams, so it's longer (more time to cool) while the tube stays as
  # wide. At each seam the line turns 180° in (or out: `wing_side`) onto a middle wall, runs back
  # against the print direction, turns in again onto an inner wall, runs forward past the seam as
  # far again, turns out onto the middle wall, back to the seam, and out onto the tube's wall: two
  # wings, mirrored about the seam. `wings` is how far they reach: 100 % to a line from the next
  # seam's wings (one seam: from each other, a triple wall all round). Past 100 % a second wing
  # grows the same way on the inner wall, at the seam (200 %: five walls), and a third past 200 %.
  # A wing starts as a shallow dent: its four turns grow from a few degrees to half circles, and
  # only then do the wings run back. The walls are a line plus the gap apart; at the seam the two
  # turns onto and off the tube's wall are a line apart, closing it.
  # (Wings take the place of a closed end: switched on, the shade is open.)
  winged   = pick(wings_on, 1, 0)
  # The wings follow the fades (the %, faded in and out), a curve along the shade, or the shape
  # (as much as keeps every layer as long as the widest). Any shape but the tube: its own radius
  # (`w_shape`); fitting it, the wings from the table below (`w_fit`).
  w_mode   = index_of(["fades", "curve", "fit the shape"], wing_mode)
  w_bycurve = less(abs(w_mode - 1), 0.5)
  w_shape  = winged * (1 - is_tube)
  w_fit    = w_shape * less(abs(w_mode - 2), 0.5)
  # The curve: rows of (where along the shade, 0 to 1; wings, %), a smooth curve through them
  # (level at the ends, never past the points); no rows: none.
  w_crows  = pick(greater(count(sample(x, wing_curve)), 0.5), wing_curve, [[0, 0]])
  w_cx     = sample(x, w_crows)
  w_cy     = max(0, sample(y, w_crows)) / 100
  # The most wings there are anywhere (wing levels for it).
  w_max    = pick(w_bycurve, item(bounds(w_cy), 1), wings)
  w_bed    = 0
  w_n      = pick(winged, round(clamp(wing_seams, 1, 8)), 1)
  # Inside (1) or outside (-1): which way from the tube's wall the wings go.
  w_sig    = 1 - 2 * less(abs(index_of(["inside", "outside"], wing_side) - 1), 0.5)
  w_J      = pick(winged, clamp(ceil(w_max - 0.000001), 1, 3), 1)
  z_w      = max(1, round(start_eff / pitch)) * pitch
  # Room inside the tube for every wall (inside wings).
  w_s      = line + wing_gap |> require(1 - winged * greater(w_sig, 0) * less(r_t - (2 * w_J + 0.5) * (line + wing_gap), 0.5), "The tube is too narrow for this many walls: fewer wings past 100 %, a wider socket, a narrower line or a smaller gap")
  rho      = w_s / 2
  w_d      = 360 / w_n
  deg      = 180 / pi

  # ---- Over the height, worked out on a fine grid (`g_`, every half layer from where the wings
  # start): how far the wings reach (0..3: 1 is 100 %), up over `wing_in` (from the bed: full at
  # once), held, down over `wing_out` (0: never), each straight or an S-curve that starts and ends
  # gently; and the tube's radius.
  # The tube or shape over its whole height: the wings from the straight start up.
  w_Ltot   = pick(w_shape, item(prof_z, count(prof_z) - 1), length)
  w_Hn     = max(0, w_Ltot - z_w)
  # Printed wide edge down (`w_rev`): the whole tube end first, from the bed, its straight start
  # last; the grid then runs over the print (`w_gz`, from the bed), and `w_gf` is each height's
  # place in the wings as they go up the tube (negative in the straight start). Start first, the
  # grid is the wings' own.
  w_rev    = winged * pick(wide_down, 1, 0)
  w_bedp   = w_rev
  z_p0     = (1 - w_rev) * z_w
  w_Hp     = pick(w_rev, w_Ltot, w_Hn)
  w_Hg     = max(0.01, w_Hp) + 2 * pitch
  w_gn     = pick(winged, ceil(w_Hg / (pitch / 2)), 1) + 1
  w_gz     = series(0, 1, w_gn) * w_Hg / (w_gn - 1)
  w_gf     = pick(w_rev, w_Ltot - z_w - w_gz, w_gz)
  w_in     = wing_in
  # The wings end where a straight end starts (more shades screw on there), or at the top; they
  # fade out over `wing_out` up to there (0: they stop at once), full in between.
  w_Hend   = max(0, w_Hn - winged * pick(end_straight, 1, 0) * end_eff)
  g_tin    = pick(greater(w_in, 0.000001), clamp(w_gf / max(w_in, 0.000001), 0, 1), 1 - less(w_gf, -0.000001))
  g_up     = pick(less(index_of(["linear", "smooth"], wing_in_curve), 0.5), g_tin, smoothstep(g_tin))
  g_tout   = clamp((w_gf - w_Hend + wing_out) / max(wing_out, 0.000001), 0, 1)
  g_down   = greater(wing_out, 0) * pick(less(index_of(["linear", "smooth"], wing_out_curve), 0.5), g_tout, smoothstep(g_tout))
  g_cs     = pick(w_bycurve, graph(w_cx, w_cy, w_gf / max(0.000001, w_Hend), smooth: true) * (1 - less(w_gf, 0)), wings * g_up * (1 - g_down)) * less(w_gf, w_Hend)
  # Fading out with "same layer length", the tube widens along the fade-out's curve, from its own
  # radius to the plain circle as long as a layer at full wings (`w_Rfin`), and the wings shrink as
  # much as keeps every layer that long: the wall flares as smoothly as the curve, the wings end
  # where it's as wide as it gets. A shape with wings is its shape, its wings as much as keeps
  # every layer as long as its widest. Either way: a layer's exact length (its turns, partial while
  # they form; the middle and inner walls; less the wall they replace) is worked out every two
  # layers up (`y_`), for wing level j, at 12 amounts of wings from none up to the most allowed
  # (more of them near none, where the turns form); the amount that gives the length to keep is
  # read off between them (the length grows with the wings).
  w_two    = greater(w_J, 1.5)
  w_three  = greater(w_J, 2.5)
  widen    = (1 - w_shape) * (1 - w_bycurve) * less(abs(index_of(["same diameter", "same layer length"], wing_widen) - 1), 0.5) * greater(wing_out, 0) * greater(w_gf, w_Hend - wing_out)
  # A layer at full wings on the tube (`x_`, per wing level), for the length to keep.
  x_j      = series(0, 1, w_J)
  x_B      = r_t - w_sig * 2 * w_s * x_j
  x_c      = clamp(wings - x_j, 0, 1)
  x_g      = asin(clamp(w_s / max(0.001, x_B - 0.5 * w_sig * w_s), 0, 1))
  x_am     = w_d / 2 - asin(clamp(w_s / max(0.001, x_B - 1.5 * w_sig * w_s), 0, 1))
  x_phi    = 180 * clamp(x_c * x_am / max(0.000001, x_g), 0, 1)
  x_full   = greater(x_phi, 179.9999)
  x_c2d    = rho - 2 * rho * cos(x_phi)
  x_c2t    = 2 * rho * sin(x_phi)
  x_th1    = w_sig * atan2(x_c2t, x_B - w_sig * (x_c2d + rho))
  x_th2    = w_sig * atan2(x_c2t - rho * sin(x_th1), x_B - w_sig * (x_c2d + rho * cos(x_th1)))
  x_th     = w_sig * atan2(x_c2t - rho * sin(x_th2), x_B - w_sig * (x_c2d + rho * cos(x_th2)))
  x_e2d    = x_c2d + rho * cos(x_th)
  x_e2t    = x_c2t - rho * sin(x_th)
  x_gam    = atan2(x_e2t, x_B - w_sig * x_e2d)
  x_x      = max(x_gam, x_g * smoothstep(clamp((x_phi - 30) / 50, 0, 1)))
  x_live   = 1 - less(x_c, 0.000000001) * greater(x_j, 0.5)
  x_a1     = x_live * (x_full * x_g + (1 - x_full) * x_x)
  x_a2     = x_live * (x_full * max(x_g, x_c * x_am) + (1 - x_full) * x_x)
  x_rM     = sqrt((x_B - w_sig * rho * (1 - cos(x_phi))) ^ 2 + (rho * sin(x_phi)) ^ 2)
  x_rI     = sqrt((x_B - w_sig * x_e2d) ^ 2 + x_e2t ^ 2)
  x_ex     = (2 * rho * (x_phi + abs(x_phi - x_th)) + 2 * (x_a2 - x_a1) * x_rM + 2 * (x_a2 - x_gam) * x_rI - 2 * x_a1 * x_B) / deg
  # The length to keep: a tube's layer at full wings; a shape's widest plain layer.
  w_hold_l = pick(w_fit, 2 * pi * item(bounds(prof_r * less(prof_z, z_w + w_Hend + 0.000001)), 1), 2 * pi * r_t + w_n * sum(x_ex))
  w_Rfin   = w_hold_l / (2 * pi)
  w_yn     = ceil(w_Hg / (2 * pitch)) + 1
  w_yz     = series(0, 1, w_yn) * w_Hg / (w_yn - 1)
  w_ym     = 12
  # At each height: the radius (a shape's own; a widening tube's along the fade-out's curve).
  y_Rp     = pick(w_shape, graph(prof_z, prof_r, z_w + pick(w_rev, w_Ltot - z_w - w_yz, w_yz)), r_t + greater(graph(w_gz, widen, w_yz), 0.5) * (w_Rfin - r_t) * graph(w_gz, g_down, w_yz))
  y_t      = series(0, 1, w_yn * w_ym * w_J)
  y_i      = floor(y_t / (w_ym * w_J))
  y_m      = floor((y_t - y_i * w_ym * w_J) / w_J)
  y_j      = y_t - y_i * w_ym * w_J - y_m * w_J
  y_B      = item(y_Rp, y_i) - w_sig * 2 * w_s * y_j
  y_c      = clamp(wings * (y_m / (w_ym - 1)) ^ 2 - y_j, 0, 1)
  y_g      = asin(clamp(w_s / max(0.001, y_B - 0.5 * w_sig * w_s), 0, 1))
  y_am     = w_d / 2 - asin(clamp(w_s / max(0.001, y_B - 1.5 * w_sig * w_s), 0, 1))
  y_phi    = 180 * clamp(y_c * y_am / max(0.000001, y_g), 0, 1)
  y_full   = greater(y_phi, 179.9999)
  y_c2d    = rho - 2 * rho * cos(y_phi)
  y_c2t    = 2 * rho * sin(y_phi)
  y_th1    = w_sig * atan2(y_c2t, y_B - w_sig * (y_c2d + rho))
  y_th2    = w_sig * atan2(y_c2t - rho * sin(y_th1), y_B - w_sig * (y_c2d + rho * cos(y_th1)))
  y_th     = w_sig * atan2(y_c2t - rho * sin(y_th2), y_B - w_sig * (y_c2d + rho * cos(y_th2)))
  y_e2d    = y_c2d + rho * cos(y_th)
  y_e2t    = y_c2t - rho * sin(y_th)
  y_gam    = atan2(y_e2t, y_B - w_sig * y_e2d)
  y_x      = max(y_gam, y_g * smoothstep(clamp((y_phi - 30) / 50, 0, 1)))
  y_live   = 1 - less(y_c, 0.000000001) * greater(y_j, 0.5)
  y_a1     = y_live * (y_full * y_g + (1 - y_full) * y_x)
  y_a2     = y_live * (y_full * max(y_g, y_c * y_am) + (1 - y_full) * y_x)
  y_rM     = sqrt((y_B - w_sig * rho * (1 - cos(y_phi))) ^ 2 + (rho * sin(y_phi)) ^ 2)
  y_rI     = sqrt((y_B - w_sig * y_e2d) ^ 2 + y_e2t ^ 2)
  y_ex     = (2 * rho * (y_phi + abs(y_phi - y_th)) + 2 * (y_a2 - y_a1) * y_rM + 2 * (y_a2 - y_gam) * y_rI - 2 * y_a1 * y_B) / deg
  y_k      = series(0, w_J, w_yn * w_ym)
  y_len    = 2 * pi * item(y_Rp, floor(series(0, 1, w_yn * w_ym) / w_ym)) + w_n * (item(y_ex, y_k) + w_two * item(y_ex, y_k + 1) + w_three * item(y_ex, y_k + 2))
  y_cum    = flatten([[0], accumulate(less(y_len, w_hold_l))])
  y_ii     = series(0, 1, w_yn)
  y_cnt    = item(y_cum, (y_ii + 1) * w_ym) - item(y_cum, y_ii * w_ym)
  y_ms     = clamp(y_cnt - 1, 0, w_ym - 2)
  y_l0     = item(y_len, y_ii * w_ym + y_ms)
  y_l1     = item(y_len, y_ii * w_ym + y_ms + 1)
  y_p      = clamp((y_ms + (w_hold_l - y_l0) / max(0.000001, y_l1 - y_l0)) / (w_ym - 1), 0, 1)
  # The wings: a shape's, as much as keeps its layer as long (at most `wings`) and no more than
  # the fade allows; a widening tube's, as much as keeps its layer as long; otherwise the fade's.
  g_need   = graph(w_yz, wings * y_p ^ 2, w_gz)
  g_c      = pick(w_fit, min(g_cs, g_need), widen * g_need + (1 - widen) * g_cs)
  g_R      = pick(w_shape, graph(prof_z, prof_r, z_w + w_gf), r_t + widen * (w_Rfin - r_t) * g_down)
  # Where the tube widens its wall leans out (degrees from vertical): overhangs, compensated as the
  # shade's are with "layer height" (the Overhangs settings): layers closer, each still extruded for
  # a whole layer, by the lean's (1 − cos) scaled by (lean / pivot)^steep. (No width compensation:
  # it isn't kept up any more.)
  w_gi     = series(0, 1, w_gn)
  g_lean   = atan2(item(g_R, min(w_gi + 1, w_gn - 1)) - item(g_R, max(w_gi - 1, 0)), item(w_gz, min(w_gi + 1, w_gn - 1)) - item(w_gz, max(w_gi - 1, 0)))
  g_cos    = max(0.05, cos(abs(g_lean)))
  g_curve  = strength * (min(abs(g_lean), 89) / pivot) ^ steep
  g_rise   = pitch * pick(less(abs(comp - 1), 0.5), max(0.05, 1 - g_curve * (1 - g_cos)), 1)
  # The layers, each its rise: as many as fit, from the count along the grid (`g_u`, layers so far
  # at each height; the grid goes two layers past the top), to the nearest whole layer.
  w_gii    = series(0, 1, w_gn - 1)
  g_u      = flatten([[0], accumulate((item(w_gz, w_gii + 1) - item(w_gz, w_gii)) * 2 / (item(g_rise, w_gii + 1) + item(g_rise, w_gii)))])
  w_layers = pick(winged, max(0, round(graph(w_gz, g_u, w_Hp))), 0)
  wing_on  = greater(w_layers, 0.5)
  # Computed for one layer when there are none (never printed).
  w_lc     = max(1, w_layers)
  w_k      = series(0, 1, w_lc)
  w_zb     = graph(g_u, w_gz, series(0, 1, w_lc + 1))
  w_lyr    = item(w_zb, w_k + 1) - item(w_zb, w_k)
  w_zl     = (item(w_zb, w_k) + item(w_zb, w_k + 1)) / 2
  # Can the deepest wings, at full, reach their full depth, or do they stay dents (seams too close
  # together for their turns)?
  w_lastB  = r_t - w_sig * 2 * w_s * (w_J - 1)
  w_dent   = less(clamp(w_max - w_J + 1, 0, 1) * (w_d / 2 - asin(clamp(w_s / max(0.001, w_lastB - 1.5 * w_sig * w_s), 0, 1))), asin(clamp(w_s / max(0.001, w_lastB - 0.5 * w_sig * w_s), 0, 1)))
  w_c      = graph(w_gz, g_c, w_zl) |> require(1 - winged * greater(w_max, 0) * w_dent, "These wings stay dents, never full turns: more wings, fewer seams, a wider tube or a narrower line", warn: true)
  w_R      = graph(w_gz, g_R, w_zl)

  # Per layer and wing level (`q`: layer k, level j; level j's tube wall is j wall pairs in): a wing
  # on a wall of radius B reaching c. Two turns facing each other (half circles a spacing s across,
  # their centres at ±b on a circle of radius ρ) come s close when their centres are 2s apart,
  # b = asin(s / ρ): the seam's turns `g`, and at 100 % each tip and the next seam's (`am`, the
  # farthest the tips go).
  w_q      = series(0, 1, w_lc * w_J)
  w_kq     = floor(w_q / w_J)
  w_jq     = w_q - w_kq * w_J
  w_cq     = clamp(item(w_c, w_kq) - w_jq, 0, 1)
  w_ks     = series(0, w_J, w_lc)

  # The wings as they are, level by level. While a wing forms its turns go `phi` round (0 to 180):
  # the first from the wall (`e1`, where it ends, in the turn's frame: d in from the wall, t along
  # it), the second about `c2` back to running along the wall, ending at `e2`, `gam` round from its
  # frame (worked out in three steps), where the inner wall starts. The turns sit `x` either side
  # of the seam: together on the seam at first (the wall just parts there), moving apart as they
  # grow, only as far as the two halves need not to cross (`gam`), out to the seam's `g` by the time
  # they're a quarter turn round (from there they come back towards each other). Formed (180°), the turns are half
  # circles: onto the middle wall at the seam's `g`, onto the inner wall at the tips `al`. A level
  # that hasn't started sits on the inner wall of the one that's growing, at the seam.
  q_B0     = item(w_R, w_kq) - w_sig * 2 * w_s * w_jq
  q_g      = asin(clamp(w_s / max(0.001, q_B0 - 0.5 * w_sig * w_s), 0, 1))
  q_am     = w_d / 2 - asin(clamp(w_s / max(0.001, q_B0 - 1.5 * w_sig * w_s), 0, 1))
  q_phi    = 180 * clamp(w_cq * q_am / max(0.000001, q_g), 0, 1)
  q_full   = greater(q_phi, 179.9999)
  q_al     = max(q_g, w_cq * q_am)
  q_e1d    = rho * (1 - cos(q_phi))
  q_e1t    = rho * sin(q_phi)
  q_c2d    = rho - 2 * rho * cos(q_phi)
  q_c2t    = 2 * rho * sin(q_phi)
  q_th1    = w_sig * atan2(q_c2t, q_B0 - w_sig * (q_c2d + rho))
  q_th2    = w_sig * atan2(q_c2t - rho * sin(q_th1), q_B0 - w_sig * (q_c2d + rho * cos(q_th1)))
  q_th     = w_sig * atan2(q_c2t - rho * sin(q_th2), q_B0 - w_sig * (q_c2d + rho * cos(q_th2)))
  q_e2d    = q_c2d + rho * cos(q_th)
  q_e2t    = q_c2t - rho * sin(q_th)
  q_gam    = atan2(q_e2t, q_B0 - w_sig * q_e2d)
  q_x      = max(q_gam, q_g * smoothstep(clamp((q_phi - 30) / 50, 0, 1)))
  q_live   = 1 - less(w_cq, 0.000000001) * greater(w_jq, 0.5)
  q_a1     = q_live * (q_full * q_g + (1 - q_full) * q_x)
  q_a2     = q_live * (q_full * q_al + (1 - q_full) * q_x)
  q_rI0    = sqrt((q_B0 - w_sig * q_e2d) ^ 2 + q_e2t ^ 2)
  w_m      = min(w_J - 1, floor(w_c))
  q_idle   = greater(w_jq, item(w_m, w_kq) + 0.5)
  q_B      = q_B0 + q_idle * (item(q_rI0, w_kq * w_J + item(w_m, w_kq)) - q_B0)
  q_rI     = q_rI0 + q_idle * (q_B - q_rI0)
  # Where the next level in starts (the inner wall runs up to it); none after the last.
  q_an     = (1 - greater(w_jq, w_J - 1.5)) * item(q_a1, w_q + 1)

  # Every piece is an arc: about a centre `rc` from the axis at angle `ac`, radius `rr`, from angle
  # `a0` round `da` (degrees). Per layer, level and seam (`u`), the seam at angle `p_s`: the tube's
  # wall to the next seam (level 0's entries; it starts where the layer before ended), the first
  # turn, the middle wall back, the second turn, the inner wall to the seam; then the same mirrored
  # about the seam, backwards.
  w_u      = series(0, 1, w_lc * w_J * w_n)
  u_q      = floor(w_u / w_n)
  u_sec    = w_u - u_q * w_n
  u_k      = floor(u_q / w_J)
  p_s      = 90 + w_d * (u_sec + 1)
  p_B      = item(q_B, u_q)
  p_a1     = item(q_a1, u_q)
  p_a2     = item(q_a2, u_q)
  p_phi    = item(q_phi, u_q)
  p_e1d    = item(q_e1d, u_q)
  p_e1t    = item(q_e1t, u_q)
  p_c2d    = item(q_c2d, u_q)
  p_c2t    = item(q_c2t, u_q)
  p_th     = item(q_th, u_q)
  p_gam    = item(q_gam, u_q)
  w_a10    = item(q_a1, w_ks)
  p_a1s    = less(u_sec, 0.5) * item(flatten([[0], w_a10]), u_k) + greater(u_sec, 0.5) * p_a1
  o_rr     = item(w_R, u_k)
  o_a0     = p_s - w_d + p_a1s
  o_da     = w_d - p_a1s - p_a1
  h1_rc    = p_B - w_sig * rho
  h1_ac    = p_s - p_a1
  h1_a0    = p_s - p_a1 + 90 * (1 - w_sig)
  h1_da    = w_sig * p_phi
  m1_rr    = sqrt((p_B - w_sig * p_e1d) ^ 2 + p_e1t ^ 2)
  m1_a0    = p_s - p_a1 + atan2(p_e1t, p_B - w_sig * p_e1d)
  m1_da    = p_a1 - p_a2
  h2_rc    = sqrt((p_B - w_sig * p_c2d) ^ 2 + p_c2t ^ 2)
  h2_ac    = p_s - p_a2 + atan2(p_c2t, p_B - w_sig * p_c2d)
  h2_a0    = p_s - p_a2 + 90 * (1 + w_sig) + w_sig * p_phi
  h2_da    = w_sig * (p_th - p_phi)
  ia_rr    = item(q_rI, u_q)
  ia_a0    = p_s - p_a2 + p_gam
  ia_da    = p_a2 - p_gam - item(q_an, u_q)
  zero     = 0 * w_u
  # The table: [tube wall, turn, middle, turn, inner, inner (mirrored), turn, middle, turn], each a
  # list over (layer, level, seam).
  t_rc     = flatten([zero, h1_rc, zero, h2_rc, zero, zero, h2_rc, zero, h1_rc])
  t_ac     = flatten([zero, h1_ac, zero, h2_ac, zero, zero, 2 * p_s - h2_ac, zero, 2 * p_s - h1_ac])
  t_rr     = flatten([o_rr, rho + zero, m1_rr, rho + zero, ia_rr, ia_rr, rho + zero, m1_rr, rho + zero])
  t_a0     = flatten([o_a0, h1_a0, m1_a0, h2_a0, ia_a0, 2 * p_s - ia_a0 - ia_da, 2 * p_s - h2_a0 - h2_da, 2 * p_s - m1_a0 - m1_da, 2 * p_s - h1_a0 - h1_da])
  t_da     = flatten([o_da, h1_da, m1_da, h2_da, ia_da, ia_da, h2_da, m1_da, h1_da])

  # Points: a fixed number per kind of piece (as many as the chord tolerance needs on the widest
  # wall, as the spiral has), so every layer has the same count. A seam's pieces in print order
  # (`w_pk`): the tube's wall; for each level in, turn, middle, turn, inner; for each level back
  # out, inner, turn, middle, turn.
  w_rmax   = item(bounds(w_R), 1) + less(w_sig, 0) * 2 * w_J * w_s
  w_no     = max(8, ceil(w_d / (2 * acos(clamp(1 - tolerance / w_rmax, 0, 0.9999)))))
  w_nh     = 2 * max(2, ceil(90 / (2 * acos(clamp(1 - tolerance / max(0.001, rho), 0, 0.9999)))))
  w_nm     = max(3, ceil(w_d / 2 / (2 * acos(clamp(1 - tolerance / w_rmax, 0, 0.9999)))))
  w_ni     = max(3, ceil(w_d / 2 / (2 * acos(clamp(1 - tolerance / w_rmax, 0, 0.9999)))))
  w_tcount = [w_no, w_nh, w_nm, w_nh, w_ni, w_ni, w_nh, w_nm, w_nh]
  w_pk     = series(0, 1, 1 + 8 * w_J)
  w_back   = greater(w_pk, 4 * w_J + 0.5)
  w_ptype  = greater(w_pk, 0.5) * (1 + mod(w_pk - 1, 4) + 4 * w_back)
  w_plev   = greater(w_pk, 0.5) * ((1 - w_back) * floor((w_pk - 1) / 4) + w_back * (w_J - 1 - floor((w_pk - 4 * w_J - 1) / 4)))
  w_LJN    = w_lc * w_J * w_n
  t_cx     = t_rc * cos(t_ac)
  t_cy     = t_rc * sin(t_ac)
  # Rising, a pitch a layer: along the whole layer by length (every bead a layer above the one
  # below it); or by angle round the tube's wall only (a thread on it), the wings level, the turn
  # back onto it at the seam rising what's left; or by angle round the innermost wings' inner wall
  # (a thread there: inside wings, a thread inside), the tube's wall level, the other wing pieces
  # rising what's left by length. As the wings fade in (and out), blended from the first (`w_lam`).
  # Each piece's share of its layer's rise per point (`t_wt`), from its arc's length or angle, so
  # the heights are a running total of the points' shares: the layers' sum to one each.
  w_rise   = index_of(["whole layer", "tube wall", "wings"], wing_rise)
  w_bywall = less(abs(w_rise - 1), 0.5)
  u_j      = u_q - u_k * w_J
  u_o      = less(u_j, 0.5)
  u_deep   = less(abs(u_j - item(w_m, u_k)), 0.5)
  l_o      = u_o * o_rr * abs(o_da) / deg
  l_h1     = rho * abs(h1_da) / deg
  l_m      = m1_rr * abs(m1_da) / deg
  l_h2     = rho * abs(h2_da) / deg
  l_i      = ia_rr * abs(ia_da) / deg
  w_eL     = l_o + 2 * (l_h1 + l_m + l_h2 + l_i)
  w_eA     = w_bywall * u_o * abs(o_da) + (1 - w_bywall) * u_deep * 2 * abs(ia_da)
  w_eF     = w_bywall * u_o * l_h1 + (1 - w_bywall) * (2 * (l_h1 + l_m + l_h2) + (1 - u_deep) * 2 * l_i)
  w_grp    = series(0, w_J * w_n, w_lc)
  w_totL   = item(flatten([[0], accumulate(w_eL)]), w_grp + w_J * w_n) - item(flatten([[0], accumulate(w_eL)]), w_grp)
  w_totA   = item(flatten([[0], accumulate(w_eA)]), w_grp + w_J * w_n) - item(flatten([[0], accumulate(w_eA)]), w_grp)
  w_totF   = item(flatten([[0], accumulate(w_eF)]), w_grp + w_J * w_n) - item(flatten([[0], accumulate(w_eF)]), w_grp)
  w_lam    = greater(w_rise, 0.5) * greater(item(w_totF, w_k), 0.000001) * clamp(w_c / max(0.000001, w_max), 0, 1)
  w_ca     = item((1 - w_lam) / max(0.000001, w_totL), u_k)
  w_cb     = item(w_lam / 360, u_k)
  w_cc     = item(w_lam * max(0, 360 - w_totA) / (360 * max(0.000001, w_totF)), u_k)
  w_fillw  = w_bywall * u_o
  w_fillo  = 1 - w_bywall
  t_wt     = flatten([abs(o_da) / w_no * (o_rr / deg * w_ca + w_bywall * w_cb), abs(h1_da) / w_nh * rho / deg * (w_ca + w_fillo * w_cc), abs(m1_da) / w_nm * m1_rr / deg * (w_ca + w_fillo * w_cc), abs(h2_da) / w_nh * rho / deg * (w_ca + w_fillo * w_cc), abs(ia_da) / w_ni * (ia_rr / deg * (w_ca + w_fillo * (1 - u_deep) * w_cc) + w_fillo * u_deep * w_cb), abs(ia_da) / w_ni * (ia_rr / deg * (w_ca + w_fillo * (1 - u_deep) * w_cc) + w_fillo * u_deep * w_cb), abs(h2_da) / w_nh * rho / deg * (w_ca + w_fillo * w_cc), abs(m1_da) / w_nm * m1_rr / deg * (w_ca + w_fillo * w_cc), abs(h1_da) / w_nh * rho / deg * (w_ca + (w_fillo + w_fillw) * w_cc)])
  # The pieces in print order (`w_e`: each seam of each layer, its pieces in turn), each one's
  # entry in the table, and its points: angles round its arc, heights from the running total of
  # the shares of the rise before it (a layer's sum to a pitch), a short series each.
  w_np     = 1 + 8 * w_J
  w_e      = series(0, 1, w_lc * w_n * w_np)
  e_blk    = floor(w_e / w_np)
  e_p      = w_e - e_blk * w_np
  e_k      = floor(e_blk / w_n)
  e_ty     = item(w_ptype, e_p)
  e_ix     = e_ty * w_LJN + (e_k * w_J + item(w_plev, e_p)) * w_n + e_blk - e_k * w_n
  # Each arc as many points as the chord tolerance needs on it (one, when there's nothing to
  # draw: a level of wings not started yet); its share of the rise spread over them.
  e_n      = max(1, ceil(abs(item(t_da, e_ix)) / (2 * acos(clamp(1 - tolerance / max(0.001, item(t_rr, e_ix)), 0, 0.9999)))))
  e_rr     = item(t_rr, e_ix)
  e_da     = item(t_da, e_ix)
  e_wt     = item(t_wt, e_ix) * item(w_tcount, e_ty) / e_n * item(w_lyr, e_k)
  e_ang    = series(item(t_a0, e_ix), e_da / e_n, e_n)
  e_z      = series(accumulate(e_n * e_wt) - e_n * e_wt + (z_p0 - pitch), e_wt, e_n)

  # The layers' points, with the last layer's end (where a next one would start). Nozzle heights
  # from where the straight start's spiral ends (its open top, on the seam), or from the bed; the
  # curve is drawn a layer lower (a toolpath prints a layer above its curve).
  w_end_a  = 450 + item(w_a10, w_lc - 1)
  # On the straight start, the first point is where its spiral ends (on the seam, at the tube's
  # radius), so the line carries straight on even when the wings start wider.
  # (From the bed the first point is the first layer's own start: the seam, at its radius.)
  w_x      = flatten([[0], item(t_cx, e_ix) + e_rr * cos(e_ang), [item(w_R, w_lc - 1) * cos(w_end_a)]])
  w_y      = flatten([[pick(w_bedp, item(w_R, 0), r_t)], item(t_cy, e_ix) + e_rr * sin(e_ang), [item(w_R, w_lc - 1) * sin(w_end_a)]])
  w_z      = flatten([[z_p0 - pitch], e_z, [z_p0 + item(w_zb, w_lc) - pitch]])
  w_curve  = polyline(point(w_x, w_y, w_z))
  w_flow   = pick(shade_flow, shade_flow, flow)
  wing_tp  = toolpath([w_curve], width: line, layer: pitch, flow: w_flow, layers: w_lc)
  # Printed wide edge down, its first layer rises off the bed, each move extruded for the gap
  # under it (as the spiral's first turn ramps).
  wing_path = pick(w_bedp, bead(wing_tp, layer: max(0.05, min(pitch, z))), wing_tp)
  # The wall as shown: the straight start, then the tube's wall layer by layer.
  wing_wall = revolve(polyline(point(flatten([pick(w_rev, [item(w_R, 0)], [r_t, r_t]), w_R]), 0, flatten([pick(w_rev, [0], [0, z_w]), z_p0 + item(w_zb, w_k + 1)])))) |> place(z: pick(w_rev, z0 + s * top_z, z0), flip: turned)

  # ---- Where it goes: its straight start along the mount's section (`along` further in), the
  # rest going up or down from there. Its own z runs from its start; in the lamp, z0 + s · z.
  hold     = pick(plain, min(start_eff, length), start_eff)
  z_a      = m_z + m_in * along
  z_b      = m_z + m_in * (along + hold)
  up       = less(abs(index_of(["up", "down"], direction)), 0.5)
  s        = pick(up, 1, -1)
  z0       = pick(up, min(z_a, z_b), max(z_a, z_b))
  # Printed wide edge down (or closed: disc down), the print is the other way round again; a
  # closed one's print starts the disc's layer below its end.
  turned_over = pick(is_closed, 1, pick(wide_down, 1, 0))
  turned   = greater(abs(1 - up - turned_over), 0.5)
  shown    = place(path, z: pick(is_closed, z0 + s * (top_z + cap_dl), pick(wide_down, z0 + s * top_z, z0)), flip: turned)
  open_wall = revolve(polyline(point(full_r, 0, full_z))) |> place(z: z0, flip: 1 - up)
  cap_shape = revolve(polyline(point(flatten([[0], cap_r]), 0, flatten([[cap_dl / 2], cap_z])))) |> place(z: z0 + s * (top_z + cap_dl), flip: up)
  wall     = pick(is_closed, cap_shape, pick(wing_on, wing_wall, open_wall))

  # ---- Ports: where more shades go. A shade outside runs a line plus the fit further out, one
  # inside as far in. The start's inside is the socket's; the end is there with a straight end.
  r_end    = pick(wing_on, item(w_R, pick(w_rev, 0, w_lc - 1)), item(full_r, count(full_r) - 1))
  end_len_at = pick(is_closed, 0, pick(plain, length, end_on * end_eff))
  # The face it's mounted by is taken (by the socket, or the shade it screws onto), but along
  # a tube there's room further on.
  m_side   = item(mount, 5)
  start_at = pick(plain, length, start_eff)
  port start_out = [r_t + line + joint_fit, z0, s, pick(less(m_side, 0) * (1 - plain), 0, start_at), 0, 1] "Start, outside"
  port start_in  = [r_t - line - joint_fit, z0, s, pick(m_socket, 0, pick(greater(m_side, 0) * (1 - plain), 0, start_at)), 0, -1] "Start, inside"
  port end_out   = [r_end + line + joint_fit, z0 + s * top_z, -s, end_len_at, 0, 1] "End, outside"
  port end_in    = [r_end - line - joint_fit, z0 + s * top_z, -s, end_len_at, 0, -1] "End, inside"
  # A tube with wings, along its full wings (between the fade-in and the fade-out): a face takes
  # a thread only where it rises exactly a pitch a turn. Rising along the tube wall, the wall's
  # free face (outside, with the wings inside; inside, with them outside); rising along the
  # wings, the deepest wings' innermost (or outermost) wall, when they're whole (100, 200 or
  # 300 %) and their turns full (a one-line slot at each tip). Rising along the whole layer no
  # wall is a helix, and while the wings fade neither is: no port.
  th_lo    = min(w_in, w_Hend)
  th_hi    = max(th_lo, w_Hend - wing_out)
  th_wing  = less(abs(w_rise - 2), 0.5) * less(abs(wings - w_J), 0.000001) * (1 - w_dent)
  th_len   = (1 - w_shape) * (1 - w_bycurve) * wing_on * greater(w_max, 0) * (w_bywall + th_wing) * (th_hi - th_lo)
  th_face  = pick(w_bywall, w_sig, -w_sig)
  th_r     = pick(w_bywall, r_t, r_t - w_sig * 2 * w_J * w_s)
  port wings_out = [th_r + line + joint_fit, z0 + s * (z_w + th_lo), s, th_len * greater(th_face, 0), 0, 1] "Wings, outside"
  port wings_in  = [th_r - line - joint_fit, z0 + s * (z_w + th_lo), s, th_len * less(th_face, 0), 0, -1] "Wings, inside"

  # ---- The Plan's marks: each piece of the profile leads to the settings that drive it, placed
  # where the shade goes.
  shade_top  = cur_top + shift
  side_x     = item(bounds(full_r), 1) + 2 * line
  not_tube   = 1 - is_tube
  mark_start   = polyline(point([r_t, r_t], 0, [0, pick(plain, length, pick(winged, z_w, throat))])) |> place(z: z0, flip: 1 - up)
  mark_fillet  = pick(blended, polyline(point(arc_r, 0, arc_z + shift)), polyline(point([r_t, r_t + 0.001], 0, [throat, throat]))) |> place(z: z0, flip: 1 - up)
  mark_shade   = polyline(point(cur_r, 0, cur_z + shift)) |> place(z: z0, flip: 1 - up)
  mark_opening = polyline(point([0, r_open], 0, [shade_top, shade_top])) |> place(z: z0, flip: 1 - up)
  w_mid        = bio_hu + bio_band / 2
  mark_widest  = polyline(point([0, r_w], 0, [w_mid + shift, w_mid + shift])) |> place(z: z0, flip: 1 - up)
  mark_height  = polyline(point([side_x, side_x], 0, [shift, shade_top])) |> place(z: z0, flip: 1 - up)
  mark_end     = polyline(point([r_end, r_end], 0, [top_z - end_eff, top_z])) |> place(z: z0, flip: 1 - up)
  mark_end_arc = polyline(point(arc2_r, 0, cur_top - arc2_z + shift)) |> place(z: z0, flip: 1 - up)
  mark mark_start for start_len, length, mount, direction, along "Start"
  mark_wings   = polyline(point(flatten([w_R, [item(w_R, w_lc - 1)]]), 0, pick(w_rev, top_z - item(w_zb, series(0, 1, w_lc + 1)), z_w + item(w_zb, series(0, 1, w_lc + 1))))) |> place(z: z0, flip: 1 - up)
  mark pick(wing_on, mark_wings, []) for wings_on, wing_mode, wings, wing_curve, wing_side, wing_seams, wing_gap, wing_rise, wing_in, wing_in_curve, wing_out, wing_out_curve, wing_widen, length "Wings"
  mark pick(not_tube, mark_fillet, []) for fillet "Fillet"
  mark pick(not_tube, mark_shade, []) for shape, opening, transition, inout_h, widest, widest_at, widest_len, widest_fillet, end_d, max_angle, sphere, flatness, own_at, own_r "Shade"
  mark pick(not_tube, mark_opening, []) for opening, end_d "Opening"
  mark pick(inout, mark_widest, []) for widest, widest_at, widest_len, widest_fillet "Widest"
  mark pick(not_tube, mark_height, []) for transition, inout_h "Height"
  mark pick(lip_on * lip_long, mark_end, []) for end_len, end_straight "Straight end"
  mark pick(lip_on * lip_arc, mark_end_arc, []) for lip_fillet, fillet "End fillet"
  # The closed end, in the shade's own z (its print turned back over: z = its end + the disc's
  # layer − the print's z).
  mark_cap     = polyline(point([0, cap_cr], 0, [top_z + cap_dl / 2, top_z + cap_dl / 2])) |> place(z: z0, flip: 1 - up)
  mark_cap_arc = polyline(point(cap_ar, 0, top_z - cap_az)) |> place(z: z0, flip: 1 - up)
  mark pick(is_closed, mark_cap, []) for closed, closed_layer "Closed end"
  mark pick(is_closed * greater(cap_f, 0), mark_cap_arc, []) for closed_fillet "Closed end's fillet"

  # ---- The shape for whoever works on it their own way: the wall's surface (through the middle
  # of the bead), exact, as a STEP surface; no thickness (a closed shade's disc included).
  export wall as "shade.step"

  show wall
  print shown
end

part main = shade(shape: "sphere", end_straight: true)
