easycad 0.1
project "Salt & pepper shaker"
printer "Ginger G1"
note "A container and a lid that screws onto it: two prints from one set of settings (EasyGCode's container, with a lid to shake salt through), each centred on the bed with its own G-code file. Each prints as one continuous line: a flat spiral from the centre out whose last turn widens onto the fillet, the fillet up into the wall, then the wall in vase mode, its layers closer where it leans out. Both spirals turn the same way, so the lid's skirt threads down over the container's neck once it's turned over onto it."
note "The body follows radii at heights (0: where the bottom fillet ends, 1: where the neck starts) along a smooth curve that leaves the fillet and meets the neck straight up. The neck is as tall as the lid's skirt; the lid sits one line width outside it, plus the fit. The lid's top is EasyGCode's spiral disc: around a ring its turns spread apart and interlock, leaving the holes the salt comes out of."
note "The lid's spiral disc can have its own layer height and line width (0: the same as the walls); the container prints with the walls' bead throughout. Through the lid's fillet the bead then eases from the disc's into the skirt's along an S-curve of height, a little at every point: the layers' spacing, the plastic each move gets and, at the set flow, its speed."

group "Container"
param body   = [[0, 33], [0.45, 38], [1, 32]] "Body radius (mm) at heights from 0 (bottom) to 1 (neck)"
param height = 60 mm in 15..300               "Height up to the neck"
param fillet = 8 mm  in 1..60                 "Bottom fillet"

group "Lid"
param skirt      = 20 mm in 3..100            "Skirt height (the neck is as tall)"
param lid_fillet = 6 mm  in 1..40             "Lid fillet"
param fit        = 0 mm  in -2..2 step 0.05   "Fit (+ looser, − tighter)"

group "Holes (the lid's spiral disc)"
param ring     = 12 mm in 1..150              "Ring radius"
param open     = 250 % in 100..400            "Spacing at the ring"
param band     = 0 mm  in 0..50               "Full-spacing band"
param fade_in  = 6 mm  in 0..60               "Fade inside the ring"
param fade_out = 6 mm  in 0..60               "Fade outside the ring"
param bumps    = 9     in 1..49 step 2        "Bumps per turn"
param touch    = 100 % in 30..100             "Spacing where the bumps meet (100 %: one line width; less: pushed into each other)"

group "Print"
param layer      = 0.6 mm in 0.1..3           "Layer height"
param line       = 2 mm   in 0.4..8           "Line width"
param disc_layer = 0 mm   in 0..3             "Lid disc layer height (0: as the walls)"
param disc_line  = 0 mm   in 0..8             "Lid disc line width (0: as the walls)"
param flow       = 20     in 1..400           "Flow (mm³/s)"
param pace       = 100 %  in 0..100           "Closer layers on overhangs"
param steep      = 0      in 0..4 step 0.1         "Steep curve (0: even; more: less when shallow, more when steep)"
param pivot      = 45 deg in 5..85 step 1          "Steep curve pivot (as set at this lean)"
param disc_extrusion = 100 % in 50..200       "Bottom and lid disc extrusion"
param wall_extrusion = 100 % in 50..200       "Fillet and wall extrusion"

# ---- The body: a smooth curve through the radii, level at both ends, so the wall leaves the
# fillet and meets the neck straight up.
points    = pick(greater(count(sample(x, body)), 0.5), body, [[0, 30]])   # no rows: a cylinder
body_at   = sample(x, points)
body_r    = sample(y, points)
bottom_r  = graph(body_at, body_r, 0, smooth: true)
neck_r    = graph(body_at, body_r, 1, smooth: true)
lid_r     = neck_r + line + fit
# The lid disc's bead (0: the walls'); the container is all the walls' bead.
disc_l    = pick(greater(disc_layer, 0), disc_layer, layer)
disc_w    = pick(greater(disc_line, 0), disc_line, line)
# Heights on whole layers: the wall up to the neck, the neck as tall as the lid's skirt.
wall_h    = max(1, round(height / layer)) * layer
neck_h    = max(1, round(skirt / layer)) * layer
# Fillets that leave room for the flat spiral inside them.
fillet_h  = max(layer, min(fillet, min((wall_h - layer) * 0.95, bottom_r - 2 * line)))
lid_fil   = max(layer, min(lid_fillet, min(neck_h * 0.95, lid_r - 2 * disc_w)))

# Sections: circles with their seam at the back (+Y), where each spiral ends and its wall starts.
unit      = circle(1) |> rotate(90) |> resample(160)
fz        = series(0, 1, 25) / 24

# ---- The container. The fillet: a quarter circle from the flat bottom up to straight.
flat_r    = bottom_r - fillet_h
fillet_r  = flat_r + sqrt(fillet_h ^ 2 - (fillet_h - fz * fillet_h) ^ 2)
fillets   = unit |> scale(fillet_r) |> move(z: layer + fz * fillet_h)
body_t    = series(1, 1, 40) / 40
bodies    = unit |> scale(graph(body_at, body_r, body_t, smooth: true)) |> move(z: layer + fillet_h + body_t * (wall_h - layer - fillet_h))
neck      = unit |> scale(neck_r) |> move(z: wall_h + neck_h)
container = loft(flatten([fillets, bodies, [neck]]))
# The wall in vase mode, layers closer on overhangs (each still a full layer's bead), open at the top.
c_wall    = spiralize(contour(container, layer, pace: pace, steep: steep, pivot: pivot), width: line, flow: flow, flat_top: false, ramp: false)
  |> bead(layer: layer) |> adjust(extrude: wall_extrusion)
# The bottom: rings one line apart from the fillet's foot inward, linked into a spiral from the
# centre out (EasyGCode's ring fill): its last turn widens onto the fillet's foot and ends on the
# seam, right where the wall starts.
c_rings   = rings(unit |> scale(flat_r), line)
c_disc    = link_rings(reverse(c_rings), "spiral", line)
c_bottom  = toolpath(c_disc, width: line, layer: layer, flow: flow) |> adjust(extrude: disc_extrusion)
base      = join([c_bottom, c_wall])

# ---- The lid, printed top down: the spiral disc with its holes, a fillet, the skirt.
lid_flat  = lid_r - lid_fil
lid_fr    = lid_flat + sqrt(lid_fil ^ 2 - (lid_fil - fz * lid_fil) ^ 2)
lid_fils  = unit |> scale(lid_fr) |> move(z: disc_l + fz * lid_fil)
skirt_top = unit |> scale(lid_r) |> move(z: disc_l + lid_fil + neck_h)
lid_shape = loft(flatten([lid_fils, [skirt_top]]))
l_blend   = smoothstep((z - disc_l) / lid_fil)
l_layer   = disc_l + (layer - disc_l) * l_blend
l_line    = disc_w + (line - disc_w) * l_blend
l_wall    = spiralize(contour(lid_shape, l_layer, pace: pace, steep: steep, pivot: pivot), width: line, flow: flow, flat_top: false, ramp: false)
  |> bead(width: l_line, layer: l_layer) |> adjust(extrude: wall_extrusion)
# Turns one line apart, spreading to `open` around the ring and interlocking there (holes); the
# spiral is stretched a hair, after the wiggles are solved, to end exactly on the fillet's foot, at
# the seam, where the skirt starts.
near      = fade(distance(circle(ring)), inside: fade_in, outside: fade_out, band: band)
spacing   = disc_w * (1 + (open - 1) * near)
odd       = 2 * floor(bumps / 2) + 1
holes     = interlock(spiral(outer: lid_flat, spacing: spacing, min_samples: 16 * odd), bumps: odd, width: disc_w, stretch: lid_flat, smooth: true, touch: touch)
l_top     = toolpath(holes |> rotate(90), width: disc_w, layer: disc_l, flow: flow) |> adjust(extrude: disc_extrusion)
lid       = join([l_top, l_wall])

# Both on the bed's centre, each its own G-code file.
show container, lid_shape
print base
print lid
